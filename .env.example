# Odoo backend the portal talks to (used by the Vite dev proxy).
# For Docker/nginx, pass it at run time instead: docker run -e ODOO_TARGET=...
ODOO_TARGET=http://41.78.157.36:8069

# Odoo database members log in to. Read at build time (it is compiled into
# the app), so change it and rebuild. For Docker: --build-arg VITE_ODOO_DB=...
VITE_ODOO_DB=ngml_corp

# Optional absolute base URL for axios (src/hooks/api.ts). Leave empty to use
# same-origin requests through the proxy.
VITE_API_BASE_URL=
